# Supabase Backend Configuration (optional for local standalone, required for cloud persistence)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# A TURN relay is required for reliable connections across restrictive NAT/firewalls.
APP_PORT=4173
STUN_URL=stun:stun.l.google.com:19302
TURN_URL=turn:turn.example.com:3478
TURN_USERNAME=swiftview
TURN_CREDENTIAL=replace-with-a-long-secret
TURN_REALM=remote.example.com
PORT=4173

# Local infrastructure. Replace every example secret before starting Compose.
POSTGRES_DB=swiftview
POSTGRES_USER=swiftview
POSTGRES_PASSWORD=replace-with-a-long-random-secret
REDIS_PASSWORD=replace-with-a-different-long-random-secret
DATABASE_URL=postgresql://swiftview:replace-me@localhost:5432/swiftview
REDIS_URL=redis://:replace-me@localhost:6379/0

# Future authenticated control-plane settings.
PUBLIC_ORIGIN=https://remote.example.com
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_CONNECT_TTL_SECONDS=120
SESSION_IDLE_TIMEOUT_SECONDS=1800
SESSION_ABSOLUTE_TIMEOUT_SECONDS=14400
